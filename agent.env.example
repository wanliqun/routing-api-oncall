# 复制到 /etc/routing-oncall/agent.env；整行注释，不在值后追加注释。
# 不填写 AWS Access Key；使用 ubuntu 已有的 /home/ubuntu/.aws/credentials。
AWS_DEFAULT_REGION=ap-southeast-1
# 若使用命名 profile，在此设置 AWS_PROFILE；默认使用 default。

ALARM_PREFIX=RoutingAPI
# 区分大小写的 Glob；多个模式用逗号分隔；留空表示不排除。
ALARM_EXCLUDE_PATTERNS=RoutingAPI-*-Latency

# 机器人自定义关键词应包含 RoutingAPI。
DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=YOUR_TOKEN
# 仅自定义关键词模式留空；启用加签时填写 SEC...。
DINGTALK_SECRET=

POLL_SECONDS=60
REMINDER_MINUTES=30
MAX_SEND_FAILURES=5
# 状态文件总字节预算：最新观测、逐项通知基线和提醒进度；不保存历史消息队列。
MAX_STATE_BYTES=2097152
# HTTP 首次、分段及重试均计入次数和时间预算。
MAX_SEND_ATTEMPTS_PER_ROUND=5
SEND_BUDGET_SECONDS=20
STATE_FILE=/var/lib/routing-oncall/state.json
# DEBUG / INFO / WARNING / ERROR / CRITICAL；仅控制 oncall 日志，默认 INFO。
LOG_LEVEL=INFO
TZ=Asia/Shanghai
